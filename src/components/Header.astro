---
import { SITE, NAV } from '../consts';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-slate-200 bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
    <a href="/" class="text-xl font-bold tracking-tight text-brand-700">
      {SITE.name}
    </a>

    <!-- Od sm: položky vedle sebe. -->
    <nav aria-label="Hlavní navigace" class="hidden sm:block">
      <ul class="flex items-center gap-6 text-sm font-medium">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'transition-colors hover:text-brand-600',
                  isActive(item.href) ? 'text-brand-600' : 'text-slate-600',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Mobil: hamburger, který rozbalí menu pod hlavičkou. -->
    <button
      id="menu-tlacitko"
      type="button"
      class="-mr-2 flex min-h-11 min-w-11 items-center justify-center rounded-lg text-slate-700 transition-colors hover:bg-slate-100 sm:hidden"
      aria-expanded="false"
      aria-controls="menu-mobil"
      aria-label="Otevřít menu"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path id="menu-ikona-otevrit" stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
        <path id="menu-ikona-zavrit" class="hidden" stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>

  <nav id="menu-mobil" aria-label="Hlavní navigace (mobil)" class="hidden border-t border-slate-200 bg-white sm:hidden">
    <ul class="px-4 py-2 text-base font-medium">
      {
        NAV.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'block min-h-11 py-3 transition-colors hover:text-brand-600',
                isActive(item.href) ? 'text-brand-600' : 'text-slate-700',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <script is:inline>
    (function () {
      var tlacitko = document.getElementById('menu-tlacitko');
      var menu = document.getElementById('menu-mobil');
      var otevrit = document.getElementById('menu-ikona-otevrit');
      var zavrit = document.getElementById('menu-ikona-zavrit');
      if (!tlacitko || !menu) return;

      function nastavit(otevreno) {
        menu.classList.toggle('hidden', !otevreno);
        otevrit.classList.toggle('hidden', otevreno);
        zavrit.classList.toggle('hidden', !otevreno);
        tlacitko.setAttribute('aria-expanded', String(otevreno));
        tlacitko.setAttribute('aria-label', otevreno ? 'Zavřít menu' : 'Otevřít menu');
      }

      tlacitko.addEventListener('click', function () {
        nastavit(menu.classList.contains('hidden'));
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') nastavit(false);
      });
    })();
  </script>
</header>
