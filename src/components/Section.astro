---
interface Props {
  title?: string;
  lead?: string;
  class?: string;
}

const { title, lead, class: className = '' } = Astro.props;
---

<section class:list={['mx-auto max-w-5xl px-4 py-16', className]}>
  {
    title && (
      <h2 class="text-3xl font-bold tracking-tight text-slate-900">{title}</h2>
    )
  }
  {lead && <p class="mt-3 max-w-2xl text-lg text-slate-600">{lead}</p>}
  <div class:list={[title || lead ? 'mt-10' : '']}>
    <slot />
  </div>
</section>
