---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
---

<BaseLayout title="O nás" description="Kdo jsme a jak pracujeme.">
  <Section title="O nás">
    <div class="max-w-2xl space-y-4 text-slate-600">
      <p>
        Sem přijde příběh firmy — kdy vznikla, proč, a co vás odlišuje.
        Konkrétní fakta fungují líp než obecné fráze.
      </p>
      <p>
        Druhý odstavec může být o týmu, přístupu k práci nebo o hodnotách,
        které se opravdu projevují v tom, jak pracujete.
      </p>
    </div>
  </Section>
</BaseLayout>
