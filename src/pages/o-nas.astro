---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import { HOUSE } from '../consts';
import zimaImg from '../assets/o-nas-zima.webp';
---

<BaseLayout
  title="O nás: architekt, stavební firma a jak stavíme"
  description="Za domem TINYHOUSE stojí stavební firma z Dobřichovic a architekt Ing. Filip Kment. Přečtěte si, proč jsme dům navrhli a jak probíhá stavba."
>
  <!--
    Úvod. Desktop: široká fotka a krátký text přímo na ní vpravo (dům je na fotce vlevo),
    bez tmavého podkladu. Mobil: fotka nahoře, text pod ní na zeleném podkladu.
  -->
  <section class="relative bg-brand-700 text-white">
    <Image
      src={zimaImg}
      alt="Dům TINYHOUSE s pultovou střechou na zasněžené stráni se sněhulákem, vpravo zasněžené hory při západu slunce"
      widths={[640, 960, 1280, 1600]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="w-full object-cover object-center sm:max-h-[85svh]"
    />

    <!-- Závoj přes fotku (jen desktop): tmavší u textu vpravo, k domu vlevo se vytrácí. -->
    <div
      class="absolute inset-0 hidden bg-linear-to-l from-black/55 via-black/25 via-45% to-transparent sm:block"
      aria-hidden="true"
    >
    </div>

    <div class="sm:absolute sm:inset-0 sm:flex sm:items-center">
      <div class="mx-auto w-full max-w-5xl px-4 py-10 sm:py-0">
        <div class="sm:ml-auto sm:max-w-md sm:text-na-fotce">
          <h1 class="text-3xl font-bold tracking-tight sm:text-5xl">O nás</h1>
          <p class="mt-3 text-lg sm:text-xl">Malý dům, který nevznikl jako kompromis.</p>
          <p class="mt-4 text-slate-100">
            Za značkou Scandy stojí stavební firma Stavbag Constructions z Dobřichovic.
            Zkušenosti ze staveb jsme promítli do malého domu pro pohodlný odpočinek.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Section title="Kdo za domem stojí" class="bg-slate-50">
    <div class="grid gap-6 sm:grid-cols-2">
      <article class="rounded-xl border border-slate-200 bg-white p-6">
        <h3 class="font-semibold text-slate-900">Architekt</h3>
        <p class="mt-1 text-lg text-slate-900">{HOUSE.architect}</p>
        <p class="mt-2 text-slate-600">
          Autor návrhu a generální projektant. Dům navrhl v roce 2025 v Řevnicích, včetně
          dispozice s úložným patrem, sedacím oknem a obou variant střechy.
        </p>
        <a
          href={HOUSE.architectUrl}
          rel="noopener"
          class="mt-3 inline-block text-sm font-medium text-brand-700 hover:underline"
        >
          filipkment.cz →
        </a>
      </article>
      <article class="rounded-xl border border-slate-200 bg-white p-6">
        <h3 class="font-semibold text-slate-900">Statika</h3>
        <p class="mt-1 text-lg text-slate-900">{HOUSE.structuralEngineer}</p>
        <p class="mt-2 text-slate-600">
          Autorizovaná inženýrka ČKAIT. Posoudila nosnou konstrukci pro sněhové oblasti I až V
          a větrové oblasti I a II, tedy pro celé území Česka.
        </p>
      </article>
    </div>
  </Section>

</BaseLayout>
