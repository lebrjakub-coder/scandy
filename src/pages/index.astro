---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import { SITE, HOUSE, formatPriceFrom } from '../consts';
import heroImg from '../assets/uvod-jezero.webp';
import pultovaImg from '../assets/galerie-jezero-molo.webp';
import sedlovaImg from '../assets/strecha-sedlova.webp';
// Další rendery (galerie-*.webp) zůstávají v src/assets pro pozdější použití, zatím se nezobrazují.

const roofImages = { pultova: pultovaImg, sedlova: sedlovaImg };

const reasons = [
  {
    title: 'Často bez povolení záměru',
    text: 'Dům je navržený jako drobná stavba podle stavebního zákona: do 55 m² a do 4 m výšky. Na pozemku určeném k rekreaci ho při splnění podmínek postavíte bez povolení.',
  },
  {
    title: 'Hotový projekt od architekta',
    text: `Dům navrhl ${HOUSE.architect}, statiku posoudila ${HOUSE.structuralEngineer}. Dokumentace pro provedení stavby je hotová, nic se nevymýšlí za pochodu.`,
  },
  {
    title: 'Panely z haly, na pozemku jen montáž',
    text: 'Stěny vyrábíme jako hotové panely a na místě je smontujeme. Dům stojí na betonových patkách nad terénem, bez základové desky a bez výkopů.',
  },
];

const steps = [
  {
    title: 'Poptávka',
    text: 'Napíšete nám, kde máte pozemek a která velikost vás zajímá. Ozveme se do dvou pracovních dnů.',
  },
  {
    title: 'Ověření pozemku',
    text: 'Zkontrolujeme územní plán a podmínky pro drobnou stavbu. Navrhneme založení podle terénu a přístup pro montáž.',
  },
  {
    title: 'Smlouva a výroba',
    text: 'Domluvíme materiály, barvy a vybavení. Panely se vyrábějí v hale, takže je nezdrží počasí.',
  },
  {
    title: 'Montáž a předání',
    text: 'Dům smontujeme na patkách, dokončíme interiér a předáme klíče. Terasu a pergolu doladíme podle pozemku.',
  },
];
---

<BaseLayout description={SITE.description}>
  <!--
    Hero. Desktop: široká fotka a krátký text položený přímo na ní vlevo (bez tmavého podkladu,
    jen stín písma). Mobil: fotka nahoře, text pod ní na zeleném podkladu.
  -->
  <section class="relative bg-brand-700 text-white">
    <Image
      src={heroImg}
      alt="Dům TINYHOUSE se sedlovou střechou a pergolou na břehu jezera, vlevo hladina a zapadající slunce"
      widths={[640, 960, 1280, 1672]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="w-full object-cover object-center sm:max-h-[85svh]"
    />

    <!-- Na fotce je dům od 38 % šířky doprava, text proto sedí u levého okraje v úzkém sloupci. -->
    <div class="sm:absolute sm:inset-0 sm:flex sm:items-center">
      <div class="w-full px-4 py-10 sm:px-12 sm:py-0">
        <div class="sm:max-w-md sm:text-na-fotce">
          <h1 class="text-4xl font-bold tracking-tight">
            Dřevěný dům do 55&nbsp;m².<br class="hidden sm:block" /> Na klíč. Od architekta.
          </h1>
          <p class="mt-4 text-lg text-slate-100">Promyšlený prostor pro váš odpočinek.</p>
          <div class="mt-8 flex flex-col gap-4 sm:flex-row">
            <!-- Na mobilu leží tlačítko na zeleném podkladu (bílé), na fotce je zelené. -->
            <a
              href="/kontakt/"
              class="rounded-lg bg-white px-6 py-3 text-center font-medium text-brand-700 transition-colors hover:bg-brand-50 sm:bg-brand-600 sm:text-white sm:hover:bg-brand-500"
            >
              Nezávazná poptávka
            </a>
            <a
              href="/dum/"
              class="rounded-lg border border-white/70 px-6 py-3 text-center font-medium text-white transition-colors hover:bg-white/10"
            >
              Prohlédnout dům
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Section title="Proč TINYHOUSE" lead="Tři věci, které u malého domu rozhodují.">
    <div class="grid gap-8 sm:grid-cols-3">
      {
        reasons.map((r) => (
          <div class="rounded-xl border border-slate-200 p-6">
            <h3 class="font-semibold text-slate-900">{r.title}</h3>
            <p class="mt-2 text-slate-600">{r.text}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Section
    title="Dva tvary střechy"
    lead="Obě varianty mají stejný půdorys i dispozici."
    class="bg-slate-50"
  >
    <div class="grid gap-8 sm:grid-cols-2">
      {
        HOUSE.roofs.map((roof) => (
          <figure>
            <Image
              src={roofImages[roof.id]}
              alt={`Dům TINYHOUSE, ${roof.name.toLowerCase()}`}
              widths={[400, 800]}
              sizes="(min-width: 640px) 50vw, 100vw"
              class="w-full rounded-xl"
            />
            <figcaption class="mt-3">
              <span class="font-semibold text-slate-900">{roof.name}</span>
              <span class="text-slate-500"> · sklon {roof.slope}</span>
              <p class="mt-1 text-slate-600">{roof.text}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </Section>

  <Section
    title="Dvě velikosti"
    lead="Stejný dům, stejná šířka 4,25 m. Liší se délkou a počtem místností."
  >
    <div class="grid gap-6 sm:grid-cols-2">
      {
        HOUSE.variants.map((v) => (
          <article class="rounded-xl border border-slate-200 p-6">
            <h3 class="text-xl font-semibold text-slate-900">{v.name}</h3>
            <dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
              <dt class="text-slate-500">Zastavěná plocha</dt>
              <dd class="font-medium text-slate-900">{v.builtUp}</dd>
              <dt class="text-slate-500">Užitná plocha</dt>
              <dd class="font-medium text-slate-900">{v.usable}</dd>
              <dt class="text-slate-500">Rozměry</dt>
              <dd class="font-medium text-slate-900">
                {v.length} × {HOUSE.width}
              </dd>
              <dt class="text-slate-500">Cena na klíč</dt>
              <dd class="font-medium text-slate-900">{formatPriceFrom(v.priceFrom)}</dd>
            </dl>
            <p class="mt-4 text-slate-600">{v.rooms}</p>
          </article>
        ))
      }
    </div>
    <p class="mt-6 text-sm text-slate-500">
      Konečná cena závisí na pozemku, založení a vybavení. Přesnou nabídku připravíme po
      prohlídce.
    </p>
  </Section>

  <Section title="Jak to probíhá" lead="Od první zprávy po předání klíčů." class="bg-slate-50">
    <ol class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((s, i) => (
          <li class="rounded-xl border border-slate-200 bg-white p-6">
            <span class="text-3xl font-bold text-brand-600">{i + 1}</span>
            <h3 class="mt-2 font-semibold text-slate-900">{s.title}</h3>
            <p class="mt-2 text-slate-600">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section>
    <div class="rounded-2xl bg-brand-700 px-6 py-12 text-center text-white sm:px-12">
      <h2 class="text-3xl font-bold tracking-tight">Máte pozemek? Ověříme, co na něm jde.</h2>
      <p class="mx-auto mt-4 max-w-2xl text-brand-100">
        Napište nám, kde pozemek leží. Řekneme vám, jestli splňuje podmínky pro drobnou
        stavbu, a připravíme nabídku pro obě velikosti.
      </p>
      <a
        href="/kontakt/"
        class="mt-8 inline-block rounded-lg bg-white px-6 py-3 font-medium text-brand-700 transition-colors hover:bg-brand-50"
      >
        Nezávazná poptávka
      </a>
    </div>
  </Section>
</BaseLayout>
