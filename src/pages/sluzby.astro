---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';

const services = [
  {
    title: 'Služba jedna',
    text: 'Co přesně zahrnuje, komu je určená a jak probíhá.',
  },
  {
    title: 'Služba dvě',
    text: 'Co přesně zahrnuje, komu je určená a jak probíhá.',
  },
  {
    title: 'Služba tři',
    text: 'Co přesně zahrnuje, komu je určená a jak probíhá.',
  },
  {
    title: 'Služba čtyři',
    text: 'Co přesně zahrnuje, komu je určená a jak probíhá.',
  },
];
---

<BaseLayout
  title="Služby"
  description="Přehled služeb, které nabízíme."
>
  <Section title="Služby" lead="Přehled toho, s čím vám můžeme pomoct.">
    <div class="grid gap-6 sm:grid-cols-2">
      {
        services.map((s) => (
          <article class="rounded-xl border border-slate-200 p-6">
            <h3 class="text-lg font-semibold text-slate-900">{s.title}</h3>
            <p class="mt-2 text-slate-600">{s.text}</p>
          </article>
        ))
      }
    </div>
  </Section>
</BaseLayout>
